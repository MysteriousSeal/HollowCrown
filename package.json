{
  "name": "hollowcrown-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev -w hollowcrown",
    "build": "npm run typecheck && npm run build -w hollowcrown",
    "preview": "npm run preview -w hollowcrown",
    "typecheck": "npm run typecheck -w @voxel/engine && npm run typecheck -w hollowcrown",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
